<%= form_with url: root_path, method: :get, class: "relative flex items-center max-w-xs w-full" do %>
  <div class="absolute left-3 flex items-center pointer-events-none text-gray-400">
    <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
    </svg>
  </div>

  <%= text_field_tag :query, params[:query], placeholder: "Search comments...",  class: "w-full pl-9 pr-4 py-2 text-[14px] font-normal text-gray-900 placeholder-gray-400 bg-gray-50 border border-gray-100 rounded-lg outline-none transition-all focus:bg-white focus:border-gray-200 focus:ring-2 focus:ring-gray-100" %>

  <%= submit_tag "Search", class: "hidden" %>
<% end %>
