<%= turbo_frame_tag "modal" do %>
  <div class="fixed inset-0 bg-black/40 backdrop-blur-sm flex items-center justify-center p-4 z-50 font-sans antialiased animate-in fade-in duration-200">
    <div class="bg-white rounded-xl shadow-xl border border-gray-100 p-6 w-full max-w-[500px] animate-in zoom-in-95 duration-200">

      <h2 class="text-[16px] font-bold text-gray-900 tracking-tight mb-4">Edit comment</h2>

      <%= render "form", comment: @comment %>

    </div>
  </div>
<% end %>
