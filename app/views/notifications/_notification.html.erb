<div class="divide-y divide-gray-50 max-h-64 overflow-y-auto">
  <div class="block w-full text-left p-3.5 hover:bg-gray-50/70 transition-colors group #{'bg-blue-50/30' unless notification.read?}">
    <div class="flex items-start justify-between gap-4">
      <p class="text-[13px] text-gray-500 leading-normal font-normal">
        <span class="font-bold text-gray-700"><%= notification.user.username %></span> 
        <%= notification.comment.body %>
      </p>
      <% unless notification.read? %>
        <%= button_to mark_as_read_notification_path(notification), 
            method: :patch,
            class: "text-[11px] font-medium text-gray-600 whitespace-nowrap hover:underline translate-y-0.5 shrink-0 cursor-pointer" do %>
          Mark as read
        <% end %>
      <% end %>
    </div>
  </div>
</div>
